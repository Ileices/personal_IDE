# =============================================
# Personal IDE - Environment Configuration
# =============================================
# Copy this file to .env and fill in your values
# =============================================

# GitHub Personal Access Token (with models:read scope)
# Get one at: https://github.com/settings/tokens
# Required scopes: read:user, models:read
GITHUB_PAT=

# GitHub OAuth App credentials (for browser-based login)
# Create at: https://github.com/settings/developers
# Set callback URL to: http://localhost:3001/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Server Configuration
SERVER_PORT=3001
SERVER_HOST=0.0.0.0

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Default project folder (where your code projects live)
# Windows example: C:\Users\YourName\Projects
# Linux example: /home/yourname/projects
DEFAULT_PROJECTS_DIR=

# Database path (SQLite file location)
DB_PATH=./data/personal-ide.db

# Memory system limits
MAX_MEMORY_NOTES_PER_PROJECT=10000
MAX_QUESTION_LOG_SIZE_MB=50
MEMORY_SEARCH_RESULTS_LIMIT=20

# Agent loop configuration
AGENT_MAX_ITERATIONS=50
AGENT_STEP_DELAY_MS=2000
AGENT_MAX_TOKENS_PER_STEP=4096

# Rate limit settings
RATE_LIMIT_BUFFER_PERCENT=10
ENABLE_PAID_USAGE=false
