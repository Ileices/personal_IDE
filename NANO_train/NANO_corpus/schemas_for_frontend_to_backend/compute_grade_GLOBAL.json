    "orchestrationEfficiencyGrading": {
        "efficiencyFormula": {
            "expression": "Efficiency = (Task_Success_Rate * 0.4) + (1 / Average_Completion_Time * 0.3) + (Resource_Utilization * 0.2) + (Network_Efficiency * 0.1)",
            "components": [
                { "metric": "Task_Success_Rate", "weight": 0.4 },
                { "metric": "1 / Average_Completion_Time", "weight": 0.3 },
                { "metric": "Resource_Utilization", "weight": 0.2 },
                { "metric": "Network_Efficiency", "weight": 0.1 }
            ],
            "notes": "Average_Completion_Time expected in seconds; 1/x normalization applied"
        },
        "networkHealthFormula": {
            "expression": "Health = (1 / Average_Latency * 0.3) + (Bandwidth_Utilization * 0.25) + (Packet_Success_Rate * 0.25) + (Sync_Accuracy * 0.2)",
            "components": [
                { "metric": "1 / Average_Latency", "weight": 0.3 },
                { "metric": "Bandwidth_Utilization", "weight": 0.25 },
                { "metric": "Packet_Success_Rate", "weight": 0.25 },
                { "metric": "Sync_Accuracy", "weight": 0.2 }
            ]
        },
        "overallOrchestratorGradeFormula": {
            "expression": "Orchestrator_Grade = (Hardware_Score * 0.4) + (Efficiency_Score * 0.3) + (Network_Health * 0.2) + (Uptime_Reliability * 0.1)",
            "components": [
                { "metric": "Hardware_Score", "weight": 0.4 },
                { "metric": "Efficiency_Score", "weight": 0.3 },
                { "metric": "Network_Health", "weight": 0.2 },
                { "metric": "Uptime_Reliability", "weight": 0.1 }
            ]
        }
    },
