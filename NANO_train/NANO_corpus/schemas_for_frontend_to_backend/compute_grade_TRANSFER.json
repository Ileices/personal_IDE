    "formulas": {
        "base_network_score": {
            "expression": "(Bandwidth × 0.4) + (Data_Limit × 0.25) + (Latency × 0.2) + (IP_Status × 0.15)",
            "components": {
                "bandwidth_weight": 0.4,
                "data_limit_weight": 0.25,
                "latency_weight": 0.2,
                "ip_status_weight": 0.15
            },
            "note": "All component scores are on their respective max-points scales (e.g., bandwidth out of 40)."
        },
        "final_network_score": {
            "expression": "Base_Score + sum(Bonuses) + sum(Geographic/Consistency Bonuses) - sum(Penalties)",
            "note": "Final score can exceed component maxima due to positive bonuses; penalties subtract after base score is computed."
        }
    },
