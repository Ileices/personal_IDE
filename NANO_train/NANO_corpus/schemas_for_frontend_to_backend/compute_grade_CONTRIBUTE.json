    "integrated_service_score_formula": {
        "base_service_score": {
            "formula_string": "(Service_Complexity × 0.4) + (Availability × 0.25) + (Resource_Efficiency × 0.2) + (Ecosystem_Impact × 0.15)",
            "weights": {
                "service_complexity": 0.4,
                "availability": 0.25,
                "resource_efficiency": 0.2,
                "ecosystem_impact": 0.15,
                "max_component_score": 40
            }
        },
        "service_multiplier": {
            "formula_string": "(Base_Service_Score / 40) × Service_Stack_Multiplier",
            "notes": "Service_Stack_Multiplier selected from service_stack_multipliers above"
        },
        "final_service_value": {
            "formula_string": "Hardware_Score × Service_Multiplier + Total_Bonuses",
            "components": [
                "Hardware_Score (external hardware valuation)",
                "Service_Multiplier (from above)",
                "Total_Bonuses (sum of applicable bonuses)"
            ]
        }
    },
