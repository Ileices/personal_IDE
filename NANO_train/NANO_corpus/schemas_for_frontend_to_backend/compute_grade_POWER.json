    "formulas": {
        "base_efficiency_score": {
            "description": "Weighted sum of component points",
            "formula": "Base = (Performance_per_Watt * 0.5) + (Energy_Source * 0.3) + (Cooling_Efficiency * 0.2)"
        },
        "final_efficiency_multiplier": {
            "description": "Apply efficiency and carbon multipliers and add percentage of total bonuses",
            "formula": "FinalMultiplier = (Efficiency_Multiplier * Carbon_Multiplier) + (Total_Bonuses / 100)"
        },
        "overall_system_value_with_efficiency": {
            "description": "Multiply hardware score by final efficiency multiplier",
            "formula": "OverallValue = Hardware_Score * FinalMultiplier"
        },
        "note": "Penalties are applied as negative percentage adjustments (e.g., -6/100 = -0.06) when modifying the FinalMultiplier"
    },
