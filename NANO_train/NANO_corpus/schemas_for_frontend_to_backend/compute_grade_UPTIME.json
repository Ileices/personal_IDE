    "scoring": {
        "formula_string": "Final Availability Score = (Base Uptime Tier Points) * (Donation Multiplier) + (Consistency Bonus) + (Predictability Bonus) - (Penalties Total)",
        "components": {
            "base_uptime_tier_points": "numeric points assigned by tier/level (see tiers[].levels[].points_range)",
            "donation_multiplier": "value selected from donation_multipliers based on donation percent",
            "consistency_bonus": "sum of matching consistency bonuses",
            "predictability_bonus": "sum of matching predictability bonuses",
            "penalties_total": "sum of applicable penalties"
        },
        "example_evaluation": "score = (base_points * multiplier) + consistency_bonus + predictability_bonus - penalties_total"
    },
